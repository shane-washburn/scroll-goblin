# Base URL of the backend API. The frontend talks ONLY to this URL,
# which keeps it fully decoupled and swappable.
VITE_API_BASE_URL=http://localhost:8787

# Optional GA4 measurement id. Leave blank locally to disable Google Analytics.
VITE_GA_MEASUREMENT_ID=

# Optional override for the public, rate-limited AWS Braket oracle.
# Defaults to the deployed Scroll Goblins service. Never put AWS keys here.
VITE_QUANTUM_API_URL=https://5o1vmqmw04.execute-api.eu-north-1.amazonaws.com/oracle

# Local Vite development only. Explicit simulated measurements; no AWS charges.
# Hardware remains the production default, even if this flag is set there.
VITE_QUANTUM_SIMULATOR=false
