            },
            "hi-IN": {
              "text": "गुब्बारा फुलाने के लिए अपने माइक्रोफ़ोन में फूंक मारो — जितनी ज़ोर से फूंक मारोगे, उतनी तेज़ी से भरेगा। फटने से पहले इसे बांध दो ताकि गुब्बारा बैंक हो जाए। पूरा भरने के बाद भी फूंक मारते रहे तो यह फट जाएगा।",
              "mtStatus": "ready",
              "humanStatus": "pending",
