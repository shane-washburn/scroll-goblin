          "limit": 265,
          "translations": {
            "en-GB": {
              "text": "Drag (or use WASD / arrows) to swim. Stay still to camouflage – predators see you from closer when you're hidden. Tap, click, or press Space to release ink and escape. Survive your way from hatchling to guardian.",
              "mtStatus": "ready",
              "humanStatus": "pending",
              "updatedAt": "2026-07-11T00:26:02.698Z",
