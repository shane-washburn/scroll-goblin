        "36f4edd83e851b558e130f4724f550f1": {
          "sourceText": "String together amino acids and hit play. The sequence picks a key, scale, tempo, and chord progression — so every protein becomes its own little song. Same sequence always sounds the same.",
          "shape": "body",
          "purpose": "body copy shown in the user interface",
          "contextVariants": [
