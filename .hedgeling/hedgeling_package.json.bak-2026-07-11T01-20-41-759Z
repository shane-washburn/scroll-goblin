          ],
          "limit": 237,
          "translations": {
            "en-GB": {
              "text": "String together amino acids and hit play. The sequence picks a key, scale, tempo, and chord progression — so every protein becomes its own little song. Same sequence always sounds the same.",
              "mtStatus": "ready",
              "humanStatus": "pending",
              "updatedAt": "2026-07-11T00:26:35.395Z",
              "source": "gemini"
            },
            "en-AU": {
              "text": "String together amino acids and hit play. The sequence picks a key, scale, tempo, and chord progression — so every protein becomes its own little song. Same sequence always sounds the same.",
              "mtStatus": "ready",
              "humanStatus": "pending",
              "updatedAt": "2026-07-11T00:26:35.395Z",
              "source": "gemini"
            },
            "en-CA": {
              "text": "String together amino acids and hit play. The sequence picks a key, scale, tempo, and chord progression — so every protein becomes its own little song. Same sequence always sounds the same.",
              "mtStatus": "ready",
              "humanStatus": "pending",
              "updatedAt": "2026-07-11T00:26:35.395Z",
              "source": "gemini"
            },
            "fr-CA": {
              "text": "Assemble des acides aminés et appuie sur lecture. La séquence choisit une tonalité, une gamme, un tempo et une progression d'accords — ainsi chaque protéine devient sa propre petite chanson. La même séquence sonne toujours pareil.",
              "mtStatus": "ready",
              "humanStatus": "pending",
              "updatedAt": "2026-07-11T00:26:35.395Z",
              "source": "gemini"
            },
            "en-IN": {
              "text": "String together amino acids and hit play. The sequence picks a key, scale, tempo, and chord progression — so every protein becomes its own little song. Same sequence always sounds the same.",
              "mtStatus": "ready",
              "humanStatus": "pending",
              "updatedAt": "2026-07-11T00:33:37.498Z",
              "source": "gemini"
            },
            "hi-IN": {
              "text": "अमीनो एसिड को एक साथ जोड़ो और प्ले करो। सीक्वेंस एक कुंजी, स्केल, टेम्पो और कॉर्ड प्रोग्रेशन चुनता है — जिससे हर प्रोटीन अपना एक छोटा गाना बन जाता है। एक ही सीक्वेंस हमेशा एक जैसा ही सुनाई देता है।",
              "mtStatus": "ready",
              "humanStatus": "pending",
              "updatedAt": "2026-07-11T00:33:37.498Z",
              "source": "gemini"
            },
            "nl-NL": {
              "text": "Rijg aminozuren aan elkaar en druk op afspelen. De sequentie kiest een toonsoort, toonladder, tempo en akkoordprogressie — zo wordt elk eiwit zijn eigen kleine liedje. Dezelfde sequentie klinkt altijd hetzelfde.",
              "mtStatus": "ready",
              "humanStatus": "pending",
              "updatedAt": "2026-07-11T00:33:37.498Z",
              "source": "gemini"
            },
            "sv-SE": {
              "text": "Sätt ihop aminosyror och tryck på spela. Sekvensen väljer tonart, skala, tempo och ackordföljd – så varje protein blir sin egen lilla låt. Samma sekvens låter alltid likadant.",
              "mtStatus": "ready",
              "humanStatus": "pending",
              "updatedAt": "2026-07-11T00:33:37.498Z",
              "source": "gemini"
            },
            "pl-PL": {
              "text": "Połącz aminokwasy i naciśnij play. Sekwencja wybiera tonację, skalę, tempo i progresję akordów — więc każde białko staje się swoją małą piosenką. Ta sama sekwencja zawsze brzmi tak samo.",
              "mtStatus": "ready",
              "humanStatus": "pending",
              "updatedAt": "2026-07-11T00:43:20.867Z",
              "source": "gemini"
            },
            "uk-UA": {
              "text": "З'єднай амінокислоти та натисни відтворити. Послідовність обирає тональність, гаму, темп і послідовність акордів — тож кожен білок стає своєю маленькою піснею. Та сама послідовність завжди звучить однаково.",
              "mtStatus": "ready",
              "humanStatus": "pending",
              "updatedAt": "2026-07-11T00:43:20.867Z",
              "source": "gemini"
            },
            "ru-RU": {
              "text": "Соедини аминокислоты и нажми играть. Последовательность выбирает тональность, гамму, темп и аккордовую прогрессию — так что каждый белок становится своей маленькой песней. Одна и та же последовательность всегда звучит одинаково.",
              "mtStatus": "ready",
              "humanStatus": "pending",
              "updatedAt": "2026-07-11T00:43:20.867Z",
              "source": "gemini"
            },
            "es-ES": {
              "text": "Une los aminoácidos y dale a reproducir. La secuencia elige una clave, escala, tempo y progresión de acordes, así que cada proteína se convierte en su propia pequeña canción. La misma secuencia siempre suena igual.",
              "mtStatus": "ready",
              "humanStatus": "pending",
              "updatedAt": "2026-07-11T00:43:20.867Z",
              "source": "gemini"
            },
            "pt-BR": {
              "text": "Junte aminoácidos e toque. A sequência escolhe uma clave, escala, tempo e progressão de acordes — assim, cada proteína vira sua própria canção. A mesma sequência sempre soa igual.",
              "mtStatus": "ready",
              "humanStatus": "pending",
              "updatedAt": "2026-07-11T00:50:04.355Z",
              "source": "gemini"
